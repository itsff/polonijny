@if (User.Identity.IsAuthenticated)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false"><strong>Administracja</strong></a>
        <div class="dropdown-menu">
            <a class="nav-link text-dark" asp-area="" asp-controller="admin" asp-action="All">Wszystkie hasła</a>
            <a class="nav-link text-dark" asp-area="" asp-controller="admin" asp-action="MegaAudit">Mega audyt (strasznie wolny)</a>
            <span class="nav-link text-dark">@User.Identity.Name</span>
            <form class="form-inline" asp-controller="Account" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </div>
    </li>
}
